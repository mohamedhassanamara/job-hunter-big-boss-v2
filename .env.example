# Copy to .env (gitignored) and fill in what you need.

# Adzuna: free keys from https://developer.adzuna.com (Adzuna has no Portugal endpoint)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Welcome to the Jungle: public Algolia search key shipped by their website.
# Only change these if WTTJ rotates the key (the Sources page will tell you).
# WTTJ_ALGOLIA_APP_ID=CSEKHVMS53
# WTTJ_ALGOLIA_KEY=

# Optional: contact info appended to the User-Agent sent to job sources.
# DISCOVERY_CONTACT=you@example.com

# Use offline mock sources instead of real ones (tests always force this).
# JOB_SOURCES=mock

# Gmail app password for the (future) send queue.
# SMTP_APP_PASSWORD=

# Optional: Hunter.io key for the "Try Hunter" button in Get contact (free plan: 25-50 a month).
# Only used when you click it; never automatic.
# HUNTER_API_KEY=

# Dev aid: slow down every API response (ms) to check skeleton states.
# MOCK_LATENCY_MS=0
