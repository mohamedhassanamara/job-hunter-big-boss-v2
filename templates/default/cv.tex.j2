\#{ Default CV template: STYLE ONLY. Every piece of content is a variable, see docs/CV_TEMPLATES.md.
   Preamble, colours, section format, spacing and commands are taken verbatim from
   templates/reference/cv.tex. Delimiters: VAR (auto-escaped), BLOCK and this comment form. }
\documentclass[\VAR{paper_class|raw},10pt]{article}

\usepackage{latexsym}
\usepackage[\VAR{paper_class|raw}, margin=0.55in, top=0.5in, bottom=0.5in]{geometry}
\usepackage{titlesec}
\usepackage{marvosym}
\usepackage[usenames,dvipsnames]{xcolor}
\usepackage{verbatim}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}
\usepackage[english]{babel}
\usepackage{tabularx}
\usepackage{fontawesome5}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

\urlstyle{same}
\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}

% --- STYLING ---
\definecolor{primaryColor}{RGB}{0, 70, 140}

\titleformat{\section}{
  \scshape\raggedright\large\color{primaryColor}
}{}{0em}{}[\color{primaryColor}\titlerule]
\titlespacing*{\section}{0pt}{6pt}{4pt}

\newcommand{\resumeItem}[1]{
  \item\small{#1}
}

\newcommand{\resumeSubheading}[4]{
  \item
    \begin{tabular*}{\textwidth}{l@{\extracolsep{\fill}}r}
      \textbf{#1} & #2 \\
      \textit{\small#3} & \textit{\small #4} \\
    \end{tabular*}
}

\newcommand{\resumeProjectHeading}[2]{
  \item
    \begin{tabular*}{\textwidth}{l@{\extracolsep{\fill}}r}
      #1 & #2 \\
    \end{tabular*}
}

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0pt, label={}, itemsep=5pt, topsep=2pt]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}[leftmargin=14pt, itemsep=1.5pt, topsep=2pt, parsep=0pt]}
\newcommand{\resumeItemListEnd}{\end{itemize}}

\#{ ---------------------------------------------------------------- macros }
\BLOCK{macro contact(item)}\faIcon{\VAR{item.icon|raw}} \BLOCK{if item.url}\href{\VAR{item.url|url}}{\underline{\VAR{item.label}}}\BLOCK{else}\VAR{item.label}\BLOCK{endif}\BLOCK{endmacro}
\BLOCK{macro dates(e)}\VAR{e.start}\BLOCK{if e.start and e.end} -- \BLOCK{endif}\VAR{e.end}\BLOCK{endmacro}
\BLOCK{macro bullets(items)}
\BLOCK{if items}
      \resumeItemListStart
\BLOCK{for b in items}
        \resumeItem{\VAR{b}}
\BLOCK{endfor}
      \resumeItemListEnd
\BLOCK{endif}
\BLOCK{endmacro}
\BLOCK{macro entry(e)}
    \resumeSubheading
      {\VAR{e.title}}{\VAR{dates(e)|raw}}
      {\VAR{e.org}}{\VAR{e.location}}
\VAR{bullets(e.bullets)|raw}
\BLOCK{endmacro}

\begin{document}

%----------HEADER----------
\begin{center}
    \textbf{\Huge \scshape \textcolor{primaryColor}{\VAR{profile.full_name}}}\BLOCK{if header_lines} \\ \vspace{4pt}
    \small
\BLOCK{for line in header_lines}
    \BLOCK{for item in line}\VAR{contact(item)|raw}\BLOCK{if not loop.last} \hspace{1pt}$|$\hspace{1pt} \BLOCK{endif}\BLOCK{endfor}\BLOCK{if not loop.last} \\ \vspace{2pt}\BLOCK{endif}

\BLOCK{endfor}
\BLOCK{endif}
\end{center}

\BLOCK{for s in sections}
\BLOCK{if s.key == 'summary'}
%-----------SUMMARY-----------
\section{\VAR{s.title}}
\small{\VAR{summary}}

\BLOCK{elif s.key == 'skills'}
%-----------SKILLS-----------
\section{\VAR{s.title}}
 \begin{itemize}[leftmargin=0pt, label={}, itemsep=1.5pt, topsep=1pt]
    \small{\item{
\BLOCK{for g in skills}
     \textbf{\VAR{g.category}}{: \VAR{g['items']|join(', ')}}\BLOCK{if not loop.last} \\\BLOCK{endif}

\BLOCK{endfor}
    }}
 \end{itemize}

\BLOCK{elif s.key == 'experience'}
%-----------EXPERIENCE-----------
\section{\VAR{s.title}}
  \resumeSubHeadingListStart
\BLOCK{for r in roles}
\VAR{entry(r)|raw}
\BLOCK{endfor}
  \resumeSubHeadingListEnd

\BLOCK{elif s.key == 'projects'}
%-----------PROJECTS-----------
\section{\VAR{s.title}}
  \resumeSubHeadingListStart
\BLOCK{for p in projects}
    \resumeProjectHeading
      {\textbf{\VAR{p.name}}\BLOCK{if p.stack} $|$ \emph{\VAR{p.stack|join(', ')}}\BLOCK{endif}}{\VAR{p.label}}
\VAR{bullets(p.bullets)|raw}
\BLOCK{endfor}
  \resumeSubHeadingListEnd

\BLOCK{elif s.key == 'certifications'}
%-----------CERTIFICATIONS-----------
\section{\VAR{s.title}}
 \begin{itemize}[leftmargin=0pt, label={}, itemsep=2pt, topsep=1pt]
    \small{\item{
\BLOCK{for c in certifications}
\BLOCK{set details = [('Issued by: ' ~ c.issuer) if c.issuer else '', ('ID: ' ~ c.credential_id) if c.credential_id else '']|select|list}
     \BLOCK{if c.url}\href{\VAR{c.url|url}}{\underline{\BLOCK{endif}\textbf{\VAR{c.name}}\BLOCK{if details} (\VAR{details|join(', ')})\BLOCK{endif}\BLOCK{if c.url}}}\BLOCK{endif}\BLOCK{if not loop.last} \\\BLOCK{endif}

\BLOCK{endfor}
    }}
 \end{itemize}

\BLOCK{elif s.key == 'education'}
%-----------EDUCATION-----------
\section{\VAR{s.title}}
  \resumeSubHeadingListStart
\BLOCK{for e in education}
    \resumeSubheading
      {\VAR{e.school}}{\VAR{dates(e)|raw}}
      {\VAR{e.degree}}{\VAR{e.location}}
\BLOCK{endfor}
  \resumeSubHeadingListEnd

\BLOCK{elif s.key == 'volunteering'}
%-----------VOLUNTEERING-----------
\section{\VAR{s.title}}
  \resumeSubHeadingListStart
\BLOCK{for v in volunteering}
\VAR{entry(v)|raw}
\BLOCK{endfor}
  \resumeSubHeadingListEnd

\BLOCK{endif}
\BLOCK{endfor}
\end{document}
