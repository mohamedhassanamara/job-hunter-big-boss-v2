\begin{center}
    \textbf{\Huge \scshape \textcolor{primaryColor}{\VAR{profile.full_name}}}\BLOCK{if header_lines} \\ \vspace{4pt}
    \small
\BLOCK{for line in header_lines}
    \BLOCK{for item in line}\VAR{contact(item)|raw}\BLOCK{if not loop.last} \hspace{1pt}$|$\hspace{1pt} \BLOCK{endif}\BLOCK{endfor}\BLOCK{if not loop.last} \\ \vspace{2pt}\BLOCK{endif}

\BLOCK{endfor}
\BLOCK{endif}
\end{center}

%----------LETTER----------
\vspace{10pt}
\begin{flushright}
  \small \VAR{place_date}
\end{flushright}

\textbf{\VAR{company}}\BLOCK{if attention} \\ \VAR{attention}\BLOCK{endif}


\textbf{\textcolor{primaryColor}{\VAR{subject}}}

\justifying

\VAR{salutation}

\BLOCK{for p in paragraphs}
\VAR{p}

\BLOCK{endfor}
\VAR{closing}

\vspace{6pt}
\textbf{\VAR{profile.full_name}}

